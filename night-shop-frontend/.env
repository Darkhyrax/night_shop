# URL base de la API
REACT_APP_BACKEND_API_URL=http://localhost:3000/api

# Entorno de la aplicación (development, test, production)
REACT_APP_ENV=development

# Versión de la aplicación (automáticamente tomada del package.json)
REACT_APP_VERSION=$npm_package_version

# Configuración de autenticación
REACT_APP_AUTH_TOKEN_KEY=night_shop_token
REACT_APP_TOKEN_EXPIRY_WARNING_MINUTES=5

# Configuración de características
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_NOTIFICATIONS=true

# Configuración de paginación
REACT_APP_DEFAULT_PAGE_SIZE=10
